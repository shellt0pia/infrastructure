[Unit]
Description=FreshRSS
Documentation=man:podman-systemd.unit(5)

[Container]
ContainerName=freshrss
Image={{ containers_images.freshrss }}:{{ containers_images_tags.freshrss }}
Network=web-egress
Network=common-internal
ExposeHostPort=80
Volume={{ containers_storage_path }}/data/freshrss/data:/var/www/FreshRSS/data:Z
Volume={{ containers_storage_path }}/data/freshrss/extensions:/var/www/FreshRSS/extensions:Z
Timezone={{ timezone }}
Environment="TZ={{ timezone }}"
Environment="CRON_MIN=1,31"
Environment="SERVER_DNS=freshrss.{{ domain_name }}"
Environment="TRUSTED_PROXY={{ traefik_podman_network | community.general.json_query("networks[*].subnets[*].subnet") | ansible.builtin.flatten | join(" ") }}"
Environment="OIDC_ENABLED=1"
Environment="OIDC_CLIENT_ID={{ freshrss.oidc.client_id }}"
Environment="OIDC_CLIENT_SECRET={{ freshrss.oidc.client_secret }}"
Environment="OIDC_CLIENT_CRYPTO_KEY={{ freshrss.oidc.client_crypto_key }}"
Environment="OIDC_PROVIDER_METADATA_URL={{ freshrss.oidc.discovery_url }}"
Environment="OIDC_SCOPES=openid email profile"
Environment="OIDC_X_FORWARDED_HEADERS=X-Forwarded-Proto X-Forwarded-Host"
Environment="OIDC_REMOTE_USER_CLAIM=preferred_username"
Label="traefik.enable=true"
Label="traefik.docker.network=common-internal"
Label="traefik.http.routers.freshrss.rule=Host(`freshrss.{{ domain_name }}`)"
Label="traefik.http.routers.freshrss.entrypoints=websecure"
Label="traefik.http.services.freshrss.loadbalancer.server.port=80"
AutoUpdate=local

[Service]
Restart=on-failure
TimeoutStartSec=300
TimeoutStopSec=70

[Install]
WantedBy=default.target
