[Unit]
Description=Cetusguard
Documentation=man:podman-systemd.unit(5)

[Container]
ContainerName=cetusguard
Image={{ containers_images.cetusguard }}:{{ containers_images_tags.cetusguard }}
ReadOnly=true
PodmanArgs=--privileged
Network=cetusguard-internal
ExposeHostPort=2375
Volume=/var/run/podman/podman.sock:/var/run/podman/podman.sock:ro
Timezone={{ timezone }}
Environment="TZ={{ timezone }}"
Environment="CETUSGUARD_BACKEND_ADDR=unix:///var/run/podman/podman.sock"
Environment="CETUSGUARD_FRONTEND_ADDR=tcp://:2375"
Environment="CETUSGUARD_RULES=! Monitor events\n\
GET %%API_PREFIX_EVENTS%%\n\
! List containers\n\
GET %%API_PREFIX_CONTAINERS%%/json\n\
! Inspect a container\n\
GET %%API_PREFIX_CONTAINERS%%/%%CONTAINER_ID_OR_NAME%%/json"
Environment="CETUSGUARD_LOG_LEVEL=6"
AutoUpdate=local

[Service]
Restart=on-failure
TimeoutStartSec=300
TimeoutStopSec=70

[Install]
WantedBy=default.target
