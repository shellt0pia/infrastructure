[Unit]
Description=Nextcloud Redis
Documentation=man:podman-systemd.unit(5)

[Container]
ContainerName=nextcloud-redis
Image={{ containers_images.nextcloud.redis }}:{{ containers_images_tags.nextcloud.redis }}
Exec=redis-server /usr/local/etc/redis/redis.conf
Network=nextcloud-redis-internal
ExposeHostPort=6379
Volume={{ containers_storage_path }}/config/nextcloud-redis/redis.conf:/usr/local/etc/redis/redis.conf:Z,ro
Volume={{ containers_storage_path }}/runtime/nextcloud-redis:/data:Z
Timezone={{ timezone }}
Environment="TZ={{ timezone }}"
HealthStartupCmd="redis-cli ping"
HealthStartPeriod=5m
HealthStartupInterval=5s
HealthCmd="redis-cli ping"
HealthInterval=1m
Notify=healthy
AutoUpdate=local

[Service]
Restart=on-failure
TimeoutStartSec=300
TimeoutStopSec=70

[Install]
WantedBy=default.target
