[Unit]
Description=Cockpit
Documentation=man:podman-systemd.unit(5)

[Container]
ContainerName=cockpit
Image={{ containers_images.cockpit }}:{{ containers_images_tags.cockpit }}
PodmanArgs=--privileged --pid=host
Network=host
Volume=/:/host
Timezone={{ timezone }}
Environment="TZ={{ timezone }}"
AutoUpdate=local

[Service]
Restart=on-failure
TimeoutStartSec=300
TimeoutStopSec=70

[Install]
WantedBy=default.target
