{
  "name": "13 - Delete seedonly build-buffer after 8 days of seeding",
  "trackerPattern": "*",
  "intervalSeconds": 3600,
  "dryRun": false,
  "conditions": {
    "schemaVersion": "1",
    "delete": {
      "enabled": true,
      "mode": "deleteWithFilesPreserveCrossSeeds",
      "condition": {
        "operator": "AND",
        "conditions": [
          {
            "field": "CATEGORY",
            "operator": "EQUAL",
            "value": "seedonly"
          },
          {
            "field": "TAGS",
            "operator": "EQUAL",
            "value": "build-buffer"
          },
          {
            "field": "CROSS_SEED_TAGS",
            "operator": "NOT_EQUAL",
            "value": "keep"
          },
          {
            "field": "SEEDING_TIME",
            "operator": "GREATER_THAN_OR_EQUAL",
            "value": "691200"
          }
        ]
      }
    }
  }
}
