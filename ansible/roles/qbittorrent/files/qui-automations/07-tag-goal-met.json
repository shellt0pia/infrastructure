{
  "name": "07 - Tag goal-met (30 days seeded and ratio goal reached)",
  "trackerPattern": "*",
  "notify": false,
  "conditions": {
    "schemaVersion": "1",
    "tags": [
      {
        "enabled": true,
        "mode": "full",
        "tags": ["goal-met"],
        "condition": {
          "operator": "AND",
          "conditions": [
            {
              "field": "CATEGORY",
              "operator": "MATCHES",
              "value": "^(tv|movies|audio|comics|seedonly)$"
            },
            {
              "field": "TAGS",
              "operator": "NOT_EQUAL",
              "value": "keep"
            },
            {
              "field": "SEEDING_TIME",
              "operator": "GREATER_THAN_OR_EQUAL",
              "value": "2592000"
            },
            {
              "field": "SEEDING_TIME",
              "operator": "LESS_THAN",
              "value": "15552000"
            },
            {
              "field": "UPLOADED_OVER_SIZE",
              "operator": "GREATER_THAN_OR_EQUAL",
              "value": "2"
            }
          ]
        }
      }
    ]
  }
}
