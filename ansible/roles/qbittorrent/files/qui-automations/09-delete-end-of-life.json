{
  "name": "09 - Delete original at end of life (goal met and idle, or 90 days)",
  "trackerPattern": "*",
  "intervalSeconds": 3600,
  "dryRun": false,
  "conditions": {
    "schemaVersion": "1",
    "delete": {
      "enabled": true,
      "mode": "deleteWithFilesPreserveCrossSeeds",
      "condition": {
        "operator": "AND",
        "conditions": [
          {
            "field": "CATEGORY",
            "operator": "MATCHES",
            "value": "^(tv|movies|audio|comics|seedonly)$"
          },
          {
            "field": "CROSS_SEED_TAGS",
            "operator": "NOT_EQUAL",
            "value": "keep"
          },
          {
            "operator": "OR",
            "conditions": [
              {
                "operator": "AND",
                "conditions": [
                  {
                    "field": "SEEDING_TIME",
                    "operator": "GREATER_THAN_OR_EQUAL",
                    "value": "2592000"
                  },
                  {
                    "field": "UPLOADED_OVER_SIZE",
                    "operator": "GREATER_THAN_OR_EQUAL",
                    "value": "2"
                  },
                  {
                    "field": "LAST_ACTIVITY",
                    "operator": "GREATER_THAN_OR_EQUAL",
                    "value": "259200"
                  }
                ]
              },
              {
                "operator": "AND",
                "conditions": [
                  {
                    "field": "SEEDING_TIME",
                    "operator": "GREATER_THAN_OR_EQUAL",
                    "value": "7776000"
                  },
                  {
                    "operator": "OR",
                    "conditions": [
                      {
                        "field": "UPLOADED_OVER_SIZE",
                        "operator": "GREATER_THAN_OR_EQUAL",
                        "value": "2"
                      },
                      {
                        "field": "LAST_ACTIVITY",
                        "operator": "GREATER_THAN_OR_EQUAL",
                        "value": "259200"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  }
}
