{
  "name": "10 - Delete original after 180 days of seeding (hard cap)",
  "trackerPattern": "*",
  "intervalSeconds": 3600,
  "dryRun": false,
  "conditions": {
    "schemaVersion": "1",
    "delete": {
      "enabled": true,
      "mode": "deleteWithFilesPreserveCrossSeeds",
      "condition": {
        "operator": "AND",
        "conditions": [
          {
            "field": "CATEGORY",
            "operator": "MATCHES",
            "value": "^(tv|movies|audio|comics|seedonly)$"
          },
          {
            "field": "CROSS_SEED_TAGS",
            "operator": "NOT_EQUAL",
            "value": "keep"
          },
          {
            "field": "SEEDING_TIME",
            "operator": "GREATER_THAN_OR_EQUAL",
            "value": "15552000"
          }
        ]
      }
    }
  }
}
