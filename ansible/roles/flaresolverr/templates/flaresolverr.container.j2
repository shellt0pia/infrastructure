[Unit]
Description=Flaresolverr
Documentation=man:podman-systemd.unit(5)

[Container]
ContainerName=flaresolverr
Image={{ containers_images.flaresolverr }}:{{ containers_images_tags.flaresolverr }}
Network=web-egress
Network=common-internal
ExposeHostPort=8191
Timezone={{ timezone }}
Environment="TZ={{ timezone }}"
Environment="CAPTCHA_SOLVER=none"
AutoUpdate=local

[Service]
Restart=on-failure
TimeoutStartSec=300
TimeoutStopSec=70

[Install]
WantedBy=default.target
