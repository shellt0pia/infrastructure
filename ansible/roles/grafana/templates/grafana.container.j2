[Unit]
Description=Grafana
Documentation=man:podman-systemd.unit(5)

[Container]
ContainerName=grafana
Image={{ containers_images.grafana }}:{{ containers_images_tags.grafana }}
Network=web-egress
Network=common-internal
ExposeHostPort=3000
#Volume={{ containers_storage_path }}/config/grafana/grafana.ini:/etc/grafana/grafana.ini:Z,ro
Volume={{ containers_storage_path }}/data/grafana:/var/lib/grafana:Z
Timezone={{ timezone }}
Environment="TZ={{ timezone }}"
Label="traefik.enable=true"
Label="traefik.docker.network=common-internal"
Label="traefik.http.routers.grafana.rule=Host(`grafana.{{ domain_name }}`)"
Label="traefik.http.routers.grafana.entrypoints=websecure"
Label="traefik.http.routers.grafana.middlewares=restrict-external-access@file"
Label="traefik.http.services.grafana.loadbalancer.server.port=3000"
AutoUpdate=local

[Service]
Restart=on-failure
TimeoutStartSec=300
TimeoutStopSec=70

[Install]
WantedBy=default.target
