{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  flux: {
    managerFilePatterns: ['/(^|/)kubernetes/.+\\.ya?ml$/'],
  },
  // Images of the plain manifests (Deployments not managed by a chart, e.g. cloudflare-ddns).
  kubernetes: {
    managerFilePatterns: ['/(^|/)kubernetes/.+\\.ya?ml$/'],
  },
  customManagers: [
    {
      customType: 'regex',
      description: 'Versions annotated with a `# renovate:` comment on the previous line',
      managerFilePatterns: ['/(^|/)talos/.+\\.ya?ml$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\n[^:\\n]+:\\s*["\']?(?<currentValue>[^"\'\\s]+)',
      ],
    },
  ],
  packageRules: [
    {
      description: 'Deployed Talos version and talosctl (mise.toml) in the same PR',
      matchDepNames: ['ghcr.io/siderolabs/installer', '/siderolabs\\/talos/'],
      groupName: 'Talos',
    },
    {
      description: 'Deployed Kubernetes version, kubectl (mise.toml) and the kubectl image (volsync-monitor) in the same PR',
      matchDepNames: ['ghcr.io/siderolabs/kubelet', '/kubernetes\\/kubernetes/', 'docker.io/alpine/k8s'],
      groupName: 'Kubernetes',
    },
    {
      description: 'Talos and Kubernetes are upgraded manually with `just talos upgrade-node` and `just talos upgrade-k8s`',
      matchDepNames: ['ghcr.io/siderolabs/installer', '/siderolabs\\/talos/', 'ghcr.io/siderolabs/kubelet', '/kubernetes\\/kubernetes/', 'docker.io/alpine/k8s'],
      matchUpdateTypes: ['major', 'minor'],
      dependencyDashboardApproval: true,
    },
  ],
}
