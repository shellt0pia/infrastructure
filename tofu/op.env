# Environment shared by every stack, the op:// references are resolved by `op run`. The provider
# credentials are in the op.env file of each stack.

# Backend (backend.hcl): application key restricted to the bucket of the states.
AWS_ACCESS_KEY_ID=op://infrastructure/backblaze-b2-tofu-state/username
AWS_SECRET_ACCESS_KEY=op://infrastructure/backblaze-b2-tofu-state/credential

# Encryption of the states and plans.
TF_VAR_state_passphrase=op://infrastructure/tofu-state-encryption/password
