# yaml-language-server: $schema=https://json.schemastore.org/helmfile
#
# Charts whose CRDs are applied with kubectl before the bootstrap apps (`just bootstrap crds`),
# so that they exist before Flux reconciles the resources using them, without dependsOn chains.
# These releases are never installed by helmfile: only their CRDs are rendered and applied.
# The chart and the values come from kubernetes/apps, as in apps.yaml.gotmpl.
#
# Only list charts that Flux installs later. CRDs in the chart `crds/` directory are skipped by
# Helm when they already exist. CRDs rendered from `templates/` (prometheus-operator-crds) are
# taken over by the helm-controller at the install, Flux leaving `install.disableTakeOwnership`
# to false. Never list the charts of apps.yaml.gotmpl: the Helm CLI of helmfile does not take
# existing objects over, and their install would fail on the ownership metadata.
#
# Run from this directory: `just bootstrap crds`.

{{- define "chart" }}
{{- $oci := printf "../../kubernetes/apps/%s/%s/app/ocirepository.yaml" .namespace .name | readFile | fromYaml }}
    chart: {{ $oci.spec.url }}
    version: {{ $oci.spec.ref.tag | quote }}
{{- end }}

templates:
  default:
    values:
      - ./templates/values.yaml.gotmpl

# Same release format as apps.yaml.gotmpl (chart template + `inherit: default`), without needs
# or hooks.
releases:
  # The monitors of the charts (ServiceMonitor, PodMonitor), docs/observability/README.md.
  - name: prometheus-operator-crds
    namespace: observability
    {{- template "chart" (dict "name" "prometheus-operator-crds" "namespace" "observability") }}
    inherit:
      - template: default
