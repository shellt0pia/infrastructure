---
# Secrets bootstrapped from 1Password (`op inject`), everything else is pulled
# by External Secrets from the `kubernetes` vault afterwards.
apiVersion: v1
kind: Namespace
metadata:
  name: external-secrets
---
# Token of the 1Password service account with read access to the `kubernetes` vault.
apiVersion: v1
kind: Secret
metadata:
  name: onepassword-service-account
  namespace: external-secrets
type: Opaque
stringData:
  token: op://kubernetes/1password-service-account-kubernetes/credential
