[Unit]
Description=Tautulli
Documentation=man:podman-systemd.unit(5)

[Container]
ContainerName=tautulli
Image={{ containers_images.tautulli }}:{{ containers_images_tags.tautulli }}
Network=web-egress
Network=common-internal
ExposeHostPort=8181
Volume={{ containers_storage_path }}/data/tautulli:/config:Z
Volume={{ containers_storage_path }}/config/tautulli/scripts:/config/scripts:Z
Secret=tautulli_tmdb_api_key
Timezone={{ timezone }}
Environment="TZ={{ timezone }}"
Environment="PLEX_CLAIM={{ plex.claim_token }}"
Environment="TMDB_API_KEY_FILE=/run/secrets/tautulli_tmdb_api_key"
Label="traefik.enable=true"
Label="traefik.docker.network=common-internal"
Label="traefik.http.routers.tautulli.rule=Host(`tautulli.{{ domain_name }}`)"
Label="traefik.http.routers.tautulli.entrypoints=websecure"
Label="traefik.http.routers.tautulli.middlewares=restrict-external-access@file"
Label="traefik.http.services.tautulli.loadbalancer.server.port=8181"
AutoUpdate=local

[Service]
Restart=on-failure
TimeoutStartSec=300
TimeoutStopSec=70

[Install]
WantedBy=default.target
