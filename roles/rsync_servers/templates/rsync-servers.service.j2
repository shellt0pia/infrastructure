[Unit]
Description=Rsync servers
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers
RequiresMountsFor={{ containers_storage_path }}/config/rsync-servers/backup-servers.sh
RequiresMountsFor={{ containers_storage_path }}/config/rsync-servers/id_ed25519
RequiresMountsFor={{ containers_storage_path }}/runtime/rsync-servers
RequiresMountsFor={{ storage_server_shares_mounts_path }}/backups/servers
RequiresMountsFor={{ storage_server_shares_mounts_path }}/backups/documents

[X-Container]
Image={{ containers_images.rsync_servers }}:{{ containers_images_tags.rsync_servers }}

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Type=oneshot
TimeoutSec=3600
Restart=no
ExecStart=/usr/bin/podman container run \
	--rm \
	--detach \
	--replace \
	--name rsync-servers \
	--cidfile=%t/%N.cid \
	--entrypoint /app/backup-servers.sh \
	--hostname {{ ansible_facts["hostname"] }} \
	--network web-egress \
	--volume {{ containers_storage_path }}/config/rsync-servers/backup-servers.sh:/app/backup-servers.sh:Z,ro \
	--volume {{ containers_storage_path }}/config/rsync-servers/id_ed25519:/root/id_ed25519:Z,ro \
	--volume {{ containers_storage_path }}/runtime/rsync-servers:/root/.ssh:Z \
	--volume {{ storage_server_shares_mounts_path }}/backups/servers:{{ storage_server_shares_mounts_path }}/backups/servers:slave \
	--volume {{ storage_server_shares_mounts_path }}/backups/documents:{{ storage_server_shares_mounts_path }}/backups/documents:slave \
	--tz {{ timezone }} \
	--env TZ={{ timezone }} \
	--env HEALTHCHECKS_URL=healthchecks.{{ domain_name }}/ping \
	--env HEALTHCHECKS_UUID={{ rsync_servers.healthchecks_uuid }} \
	--env CONTAINERS_HOSTS="{% for host in groups['containers_hosts'] %}{{ hostvars[host].ansible_host }}{{ " " if not loop.last else "" }}{% endfor %}" \
	--env DOCUMENTS_HOST="{{ hostvars['cloud'].ansible_host }}" \
	--env CONTAINERS_HOSTS_REMOTE_PATH={{ containers_storage_path }}/.snapshot/data \
	--env DOCUMENTS_HOST_REMOTE_PATH={{ hostvars['cloud'].storage_server_shares_mounts_path }} \
	--env CONTAINERS_HOSTS_LOCAL_PATH={{ storage_server_shares_mounts_path }}/backups/servers \
	--env DOCUMENTS_HOST_LOCAL_PATH={{ storage_server_shares_mounts_path }}/backups/documents {{ containers_images.rsync_servers }}:{{ containers_images_tags.rsync_servers }}
ExecStopPost=-/usr/bin/podman rm -v -f -i --cidfile=%t/%N.cid

[Install]
WantedBy=default.target
