{
  "name": "06 - Tag goal-pending (seeding goals not met yet)",
  "trackerPattern": "*",
  "notify": false,
  "conditions": {
    "schemaVersion": "1",
    "tags": [
      {
        "enabled": true,
        "mode": "full",
        "tags": ["goal-pending"],
        "condition": {
          "operator": "AND",
          "conditions": [
            {
              "field": "CATEGORY",
              "operator": "MATCHES",
              "value": "^(tv|movies|audio|comics|seedonly)(\\.cross)?$"
            },
            {
              "field": "TAGS",
              "operator": "NOT_EQUAL",
              "value": "keep"
            },
            {
              "operator": "OR",
              "conditions": [
                {
                  "field": "SEEDING_TIME",
                  "operator": "LESS_THAN",
                  "value": "2592000"
                },
                {
                  "field": "UPLOADED_OVER_SIZE",
                  "operator": "LESS_THAN",
                  "value": "2"
                }
              ]
            },
            {
              "field": "SEEDING_TIME",
              "operator": "LESS_THAN",
              "value": "7776000"
            }
          ]
        }
      }
    ]
  }
}
