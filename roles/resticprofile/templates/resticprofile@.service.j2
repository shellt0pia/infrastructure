[Unit]
Description=resticprofile %i
Wants=network-online.target
After=network-online.target
After=btrfs-snapshot@{{ containers_storage_path | systemd_escape(path=True) }}.service
RequiresMountsFor=%t/containers
RequiresMountsFor={{ containers_storage_path }}/config/resticprofile
RequiresMountsFor={{ containers_storage_path }}/runtime/resticprofile/cache
{% for source in resticprofile.sources %}
RequiresMountsFor={{ source }}
{% endfor %}

[X-Container]
Image={{ containers_images.resticprofile }}:{{ containers_images_tags.resticprofile }}

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Type=oneshot
# The first backup of a host can take a very long time, Healthchecks warns about stuck runs instead.
TimeoutStartSec=infinity
TimeoutStopSec=70
Restart=no
# This container needs access to other containers data labeled using the "Z" exclusive SELinux context mount option.
# Instead of changing every other containers mounts options, we disable SELinux labelling on this container mounts.
ExecStart=/usr/bin/podman container run \
	--rm \
	--replace \
	--name resticprofile-%i \
	--cidfile=%t/%N.cid \
	--hostname {{ ansible_facts["hostname"] }} \
	--network web-egress \
	--security-opt label=disable \
	--volume {{ containers_storage_path }}/config/resticprofile:/resticprofile:Z,ro \
	--volume {{ containers_storage_path }}/runtime/resticprofile/cache:/cache:Z \
{% for source in resticprofile.sources %}
	--volume {{ source }}:{{ source }}:rslave,ro \
{% endfor %}
	--secret resticprofile_repository_password \
{% for key in resticprofile.environment | default({}) %}
	--secret resticprofile_{{ key | lower }},type=env,target={{ key }} \
{% endfor %}
	--tz {{ timezone }} \
	--env TZ={{ timezone }} {{ containers_images.resticprofile }}:{{ containers_images_tags.resticprofile }} --lock-wait 2h %i
ExecStopPost=-/usr/bin/podman rm -v -f -i --cidfile=%t/%N.cid

[Install]
WantedBy=default.target
