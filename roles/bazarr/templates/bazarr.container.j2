[Unit]
Description=Bazarr
Documentation=man:podman-systemd.unit(5)

[Container]
ContainerName=bazarr
Image={{ containers_images.bazarr }}:{{ containers_images_tags.bazarr }}
Network=web-egress
Network=common-internal
ExposeHostPort=6767
Volume={{ containers_storage_path }}/data/bazarr:/config:Z
Volume={{ storage_server_shares_mounts_path }}/media/library/movies:/mnt/media/library/movies:slave
Volume={{ storage_server_shares_mounts_path }}/media/library/tv:/mnt/media/library/tv:slave
Timezone={{ timezone }}
Environment="TZ={{ timezone }}"
Label="traefik.enable=true"
Label="traefik.docker.network=common-internal"
Label="traefik.http.routers.bazarr.rule=Host(`bazarr.{{ domain_name }}`)"
Label="traefik.http.routers.bazarr.entrypoints=websecure"
Label="traefik.http.routers.bazarr.middlewares=restrict-external-access@file"
Label="traefik.http.services.bazarr.loadbalancer.server.port=6767"
AutoUpdate=local

[Service]
Restart=on-failure
TimeoutStartSec=300
TimeoutStopSec=70

[Install]
WantedBy=default.target
