[Unit]
Description=Sonarr
Documentation=man:podman-systemd.unit(5)

[Container]
ContainerName=sonarr
Image={{ containers_images.sonarr }}:{{ containers_images_tags.sonarr }}
Network=web-egress
Network=common-internal
ExposeHostPort=8989
Volume={{ containers_storage_path }}/data/sonarr:/config:Z
Volume={{ storage_server_shares_mounts_path }}/media/download/bittorrent/tv:/mnt/media/download/bittorrent/tv:slave,ro
Volume={{ storage_server_shares_mounts_path }}/media/download/usenet/complete/tv:/mnt/media/download/usenet/complete/tv:slave,ro
Volume={{ storage_server_shares_mounts_path }}/media/library/tv:/mnt/media/library/tv:slave
Timezone={{ timezone }}
Environment="TZ={{ timezone }}"
Label="traefik.enable=true"
Label="traefik.docker.network=common-internal"
Label="traefik.http.routers.sonarr.rule=Host(`sonarr.{{ domain_name }}`)"
Label="traefik.http.routers.sonarr.entrypoints=websecure"
Label="traefik.http.routers.sonarr.middlewares=restrict-external-access@file"
Label="traefik.http.services.sonarr.loadbalancer.server.port=8989"
AutoUpdate=local

[Service]
Restart=on-failure
TimeoutStartSec=300
TimeoutStopSec=70

[Install]
WantedBy=default.target
