[Unit]
Description=Lidarr
Documentation=man:podman-systemd.unit(5)

[Container]
ContainerName=lidarr
Image={{ containers_images.lidarr }}:{{ containers_images_tags.lidarr }}
Network=web-egress
Network=common-internal
ExposeHostPort=8686
Volume={{ containers_storage_path }}/data/lidarr:/config:Z
Volume={{ storage_server_shares_mounts_path }}/media/download/bittorrent/audio:/mnt/media/download/bittorrent/audio:slave,ro
Volume={{ storage_server_shares_mounts_path }}/media/download/usenet/complete/audio:/mnt/media/download/usenet/complete/audio:slave,ro
Volume={{ storage_server_shares_mounts_path }}/media/library/music:/mnt/media/library/music:slave
Timezone={{ timezone }}
Environment="TZ={{ timezone }}"
Label="traefik.enable=true"
Label="traefik.docker.network=common-internal"
Label="traefik.http.routers.lidarr.rule=Host(`lidarr.{{ domain_name }}`)"
Label="traefik.http.routers.lidarr.entrypoints=websecure"
Label="traefik.http.routers.lidarr.middlewares=restrict-external-access@file"
Label="traefik.http.services.lidarr.loadbalancer.server.port=8686"
AutoUpdate=local

[Service]
Restart=on-failure
TimeoutStartSec=300
TimeoutStopSec=70

[Install]
WantedBy=default.target
