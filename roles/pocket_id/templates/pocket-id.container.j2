[Unit]
Description=Pocket ID
Documentation=man:podman-systemd.unit(5)

[Container]
ContainerName=pocket-id
Image={{ containers_images.pocket_id }}:{{ containers_images_tags.pocket_id }}
User=1000
Group=1000
ReadOnly=true
Network=web-egress
Network=common-internal
ExposeHostPort=1411
Volume={{ containers_storage_path }}/data/pocket-id:/app/data:Z
Secret=pocket_id_encryption_key
Timezone={{ timezone }}
Environment="TZ={{ timezone }}"
Environment="APP_URL=https://id.{{ domain_name }}"
Environment="ENCRYPTION_KEY_FILE=/run/secrets/pocket_id_encryption_key"
Environment="TRUST_PROXY={{ traefik_podman_network | community.general.json_query("networks[*].subnets[*].subnet") | ansible.builtin.flatten | join(",") }}"
Environment="ANALYTICS_DISABLED=true"
Environment="ALLOW_INSECURE_CALLBACK_URLS=false"
# Enables IP geolocation in the audit log (free MaxMind account required)
# Environment="MAXMIND_LICENSE_KEY="
Label="traefik.enable=true"
Label="traefik.docker.network=common-internal"
Label="traefik.http.routers.pocket-id.rule=Host(`id.{{ domain_name }}`)"
Label="traefik.http.routers.pocket-id.entrypoints=websecure"
Label="traefik.http.services.pocket-id.loadbalancer.server.port=1411"
# JSON array form required (exec form): the distroless image has no shell for CMD-SHELL
HealthCmd=["/app/pocket-id","healthcheck"]
HealthStartPeriod=10s
HealthInterval=1m30s
HealthTimeout=5s
HealthRetries=2
AutoUpdate=local

[Service]
Restart=on-failure
TimeoutStartSec=300
TimeoutStopSec=70

[Install]
WantedBy=default.target
