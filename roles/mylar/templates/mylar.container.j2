[Unit]
Description=Mylar 3
Documentation=man:podman-systemd.unit(5)

[Container]
ContainerName=mylar
Image={{ containers_images.mylar }}:{{ containers_images_tags.mylar }}
Network=web-egress
Network=common-internal
ExposeHostPort=8090
Volume={{ containers_storage_path }}/data/mylar:/config:Z
Volume={{ storage_server_shares_mounts_path }}/media/download/bittorrent/comics:/mnt/media/download/bittorrent/comics:slave,ro
Volume={{ storage_server_shares_mounts_path }}/media/download/usenet/complete/comics:/mnt/media/download/usenet/complete/comics:slave,ro
Volume={{ storage_server_shares_mounts_path }}/media/library/comics:/mnt/media/library/comics:slave
Timezone={{ timezone }}
Environment="TZ={{ timezone }}"
Label="traefik.enable=true"
Label="traefik.docker.network=common-internal"
Label="traefik.http.routers.mylar.rule=Host(`mylar.{{ domain_name }}`)"
Label="traefik.http.routers.mylar.entrypoints=websecure"
Label="traefik.http.routers.mylar.middlewares=restrict-external-access@file"
Label="traefik.http.services.mylar.loadbalancer.server.port=8090"
AutoUpdate=local

[Service]
Restart=on-failure
TimeoutStartSec=300
TimeoutStopSec=70

[Install]
WantedBy=default.target
