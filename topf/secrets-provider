#!/usr/bin/env bash
# topf secrets provider (`secretsProvider` in topf.yaml): `secrets-provider secrets get|put <cluster>`.
# Prints the Talos secrets bundle stored in 1Password, read with the workstation service
# account (docs/1password-local-access.md). Nothing is written to disk.
set -euo pipefail

vault=infrastructure
item=talos-secrets

case "${1:-} ${2:-}" in
    'secrets get')
        # Must fail rather than print nothing: topf would take an empty output as a missing
        # bundle and generate a new one.
        exec op document get "$item" --vault "$vault"
        ;;
    'secrets put')
        # The service account is read-only and the bundle must never be replaced by mistake.
        echo "Refusing to store a new secrets bundle: create it with \`just topf gen-secrets\`." >&2
        exit 1
        ;;
    *)
        echo "Usage: $0 secrets get|put <cluster>" >&2
        exit 2
        ;;
esac
